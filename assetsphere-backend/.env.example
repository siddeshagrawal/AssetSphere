# =============================================================================
# AssetSphere backend — local development
# =============================================================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Backend PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5433/assetsphere
DB_HOST=localhost
DB_PORT=5433
DB_NAME=assetsphere
DB_USERNAME=assetsphere
DB_PASSWORD=<DB_PASSWORD>

# Docker Compose PostgreSQL bootstrap only
POSTGRES_DB=assetsphere
POSTGRES_USER=assetsphere
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_HOST_PORT=5433

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=

# Authentication, browser origins, and frontend links
ASSETSPHERE_JWT_SECRET=<AT_LEAST_32_BYTE_RANDOM_SECRET>
ASSETSPHERE_ACCESS_TOKEN_TTL_SECONDS=900
ASSETSPHERE_CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>
MINIO_BUCKET=assetsphere
MINIO_AUTO_CREATE_BUCKET=true

# OpenAI and generative AI (optional)
ASSETSPHERE_AI_ENABLED=false
OPENAI_API_KEY=<OPENAI_API_KEY>
ASSETSPHERE_AI_MODEL=gpt-4o-mini
ASSETSPHERE_AI_SPRING_CHAT_MODEL=none

# Semantic embeddings (optional; text-embedding-3-small produces 1536 dimensions)
ASSETSPHERE_AI_EMBEDDING_ENABLED=false
ASSETSPHERE_AI_SPRING_EMBEDDING_MODEL=none
ASSETSPHERE_AI_EMBEDDING_MODEL=text-embedding-3-small
ASSETSPHERE_AI_EMBEDDING_DIMENSION=1536

# MP4/WebM transcription (optional; no standalone audio upload support)
ASSETSPHERE_AI_TRANSCRIPTION_ENABLED=false
ASSETSPHERE_AI_TRANSCRIPTION_MODEL=whisper-1
ASSETSPHERE_AI_TRANSCRIPTION_MAX_FILE_SIZE=25MB
ASSETSPHERE_AI_TRANSCRIPTION_MAX_TEXT_LENGTH=200000

# Google OAuth (optional)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_FRONTEND_SUCCESS_URL=http://localhost:5173/oauth/callback
GOOGLE_FRONTEND_FAILURE_URL=http://localhost:5173/login

# SMTP invitation delivery (optional; manual-copy flow remains available)
EMAIL_ENABLED=false
EMAIL_FROM=<VERIFIED_SENDER_EMAIL>
EMAIL_TIME_ZONE=Asia/Kolkata
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_AUTH=true
SMTP_TLS=true

# Development payments: STRIPE with test credentials, or RAZORPAY_LOCAL
ASSETSPHERE_PAYMENT_MODE=STRIPE
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=<STRIPE_TEST_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=<STRIPE_TEST_PUBLISHABLE_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_TEST_WEBHOOK_SECRET>
STRIPE_PRO_PRICE_ID=<STRIPE_TEST_PRO_PRICE_ID>

# Local Razorpay demo only — forbidden by the prod profile
ASSETSPHERE_LOCAL_RAZORPAY_ENABLED=false
LOCAL_RAZORPAY_VARIANT=MY
LOCAL_RAZORPAY_BASE_URL=http://localhost:8082
LOCAL_RAZORPAY_KEY_ID=<LOCAL_RAZORPAY_KEY_ID>
LOCAL_RAZORPAY_KEY_SECRET=<LOCAL_RAZORPAY_KEY_SECRET>
LOCAL_RAZORPAY_WEBHOOK_SECRET=<LOCAL_RAZORPAY_WEBHOOK_SECRET>
ASSETSPHERE_LOCAL_RAZORPAY_POLL_CONFIRMATION_ENABLED=false
ASSETSPHERE_LOCAL_RAZORPAY_NON_TERMINAL_CACHE_TTL=PT3S
ASSETSPHERE_LOCAL_RAZORPAY_TERMINAL_CACHE_TTL=PT30S

# Authorized operational DLT inspection/replay API
ASSETSPHERE_DLT_OPS_ENABLED=false
ASSETSPHERE_DLT_OPS_MAX_RECORDS=100

# =============================================================================
# Production overrides — use a platform secret store, not this file
# =============================================================================
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://<HOST>:5432/<DATABASE>?sslmode=require
# DB_USERNAME=<DATABASE_USERNAME>
# DB_PASSWORD=<DATABASE_PASSWORD>
# REDIS_URL=rediss://<HOST>:<PORT>
# REDIS_USERNAME=<REDIS_USERNAME>
# REDIS_PASSWORD=<REDIS_PASSWORD>
# REDIS_SSL_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=<HOSTED_KAFKA_BROKERS>
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=<SASL_MECHANISM>
# KAFKA_SASL_JAAS_CONFIG=<SASL_JAAS_CONFIG>
# KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=https
# MINIO_ENDPOINT=https://<S3_COMPATIBLE_ENDPOINT>
# MINIO_AUTO_CREATE_BUCKET=false
# ASSETSPHERE_CORS_ALLOWED_ORIGINS=https://<FRONTEND_HOST>
# FRONTEND_BASE_URL=https://<FRONTEND_HOST>
# ASSETSPHERE_PAYMENT_MODE=STRIPE
# STRIPE_SECRET_KEY=<STRIPE_LIVE_SECRET_KEY>
# STRIPE_PUBLISHABLE_KEY=<STRIPE_LIVE_PUBLISHABLE_KEY>
# STRIPE_WEBHOOK_SECRET=<STRIPE_LIVE_WEBHOOK_SECRET>
# STRIPE_PRO_PRICE_ID=<STRIPE_LIVE_PRO_PRICE_ID>
