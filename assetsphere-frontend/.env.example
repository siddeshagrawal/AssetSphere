# Public backend origin only. Production must use the public HTTPS backend origin.
VITE_API_BASE_URL=http://localhost:8080

# Optional public social links, used only when configured by the frontend.
VITE_SOCIAL_GITHUB_URL=
VITE_SOCIAL_LINKEDIN_URL=

# Never put backend/provider secrets, API keys, webhook secrets, JWT secrets,
# SMTP credentials, database credentials, or storage credentials in VITE_* values.
